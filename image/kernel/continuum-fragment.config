# Continuum node kernel config fragment (ARCH-002 §06) -- merge into a
# Raspberry Pi 5 (bcm2712) Linux kernel .config with:
#
#   ARCH=arm64 scripts/kconfig/merge_config.sh .config \
#       image/kernel/continuum-fragment.config
#
# Not a full defconfig: Buildroot's own linux-raspberrypi tree provides
# the base bcm2712_defconfig covering the SoC's drivers, storage,
# networking, etc. This fragment adds only what's specifically required
# by swapd, shard-execd, and continuumd -- see each option's comment for
# which component needs it and why.

# swapd's paging_engine.c: real userfaultfd demand paging (ARCH-001 §05,
# ARCH-002 §05). Present by default on most configs, but pinned
# explicitly since it's a correctness requirement, not a nice-to-have --
# see paging_engine.c's fallback path for what happens without it.
CONFIG_USERFAULTFD=y

# swapd's tier-3 local NVMe reads (ARCH-002 §05's "real io_uring
# demand-paging design"; this reference build's paging_engine.c currently
# uses synchronous pread() -- see its module comment -- but the kernel
# side is enabled now so that optimization is a userspace-only change
# later, not a kernel rebuild).
CONFIG_IO_URING=y

# continuumd's process supervision + cgroup placement (kernel/src/
# cgroup_util.c, ARCH-002 §04): cgroup v2 unified hierarchy.
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_MEMCG=y
CONFIG_PIDS_CGROUP=y
# cgroup v1 controllers are not needed -- continuumd only ever writes to
# /sys/fs/cgroup as a v2 unified mount (see cgroup_util.c).

# shard-execd's quantized matmul kernels (services/shard-execd/src/
# toy_model.c uses ARM NEON intrinsics directly -- this is a userspace
# ISA feature, not a kernel driver, but NEON must not be configured out
# of the kernel's own FP/SIMD context-switch support on arm64 builds
# that allow disabling it for size).
CONFIG_ARM64=y
CONFIG_KERNEL_MODE_NEON=y

# swapd's shared DRAM pool + page table (lib/pagetable): POSIX shared
# memory over tmpfs, and shm_open()'s underlying POSIX IPC namespace.
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_POSIX_MQUEUE=y

# Every daemon's TCP wire protocol (lib/wire) and Unix domain socket IPC
# (swapd/shard-execd/schedulerd's local sockets) -- baseline, but pinned
# since a minimal defconfig sometimes trims IPv6/Unix socket support.
CONFIG_INET=y
CONFIG_UNIX=y
